        "summary": "Get invoice by name",
        "description": "Fetches an invoice by its exact name (e.g., FVEO-7439), including lines, product codes, quantities, prices, serial numbers and sale order.",
        "operationId": "get_invoice",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "invoice_name",
            "in": "path",
            "required": true,
