                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket_ref}": {
      "get": {
        "tags": [
          "Tickets"
        ],
        "summary": "Get ticket by reference",
        "description": "Fetches a support ticket by its reference number without '#' (e.g., 0001). Returns subject, customer, description, stage, priority and creation date.",
        "operationId": "get_ticket",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ticket_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticket Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
