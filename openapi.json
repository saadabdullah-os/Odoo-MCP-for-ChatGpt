              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/partners/by-phone": {
      "get": {
        "tags": [
          "Partners"
        ],
        "summary": "Find partner by phone",
        "description": "Finds a customer/supplier by phone or mobile. Only digits are compared and country prefixes are tolerated (e.g., +57 3001234567 matches 3001234567).",
        "operationId": "get_partner_by_phone",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "phone",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Phone"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/partners/search": {
      "get": {
        "tags": [
          "Partners"
        ],
        "summary": "Search partners",
        "description": "Searches customers/suppliers by name, NIT/VAT (exact, e.g., 900123456-7) or phone (exact as stored in Odoo). Provide at least one parameter.",
        "operationId": "search_partners",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Name"
            }
          },
          {
            "name": "nit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Nit"
            }
          },
          {
            "name": "phone",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Phone"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/by-date": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "Get invoices by date",
        "description": "Fetches all customer and vendor invoices for a date (YYYY-MM-DD), including lines, product codes, quantities, prices, serial numbers and sale orders.",
        "operationId": "get_invoices_by_date",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Date"
